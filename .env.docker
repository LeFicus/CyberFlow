# CyberFlow Docker 环境变量
# 复制为 .env 后修改

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_USER=root

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# JWT
JWT_SECRET=cyberflow-admin-jwt-secret-key-2026

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
RDAP_URL=https://rdap.org/domain/{domain}
SITE_GENERATION_MAX_ATTEMPTS=5

# 爬虫平台配置（后台配置优先，这些值仅作消费者兜底）
ADMIN_API_BASE_URL=http://216.152.147.6
ADMIN_API_USERNAME=yg001
ADMIN_API_PASSWORD=123456
PAYMENT_API_BASE_URL=https://c4partypay.com
PAYMENT_API_ACCOUNT=lingui
PAYMENT_API_PASSWORD=lingui123
VERIFY_SSL=true

# Allow large product catalogs to finish; value is in seconds.
PRODUCT_CRAWL_TIMEOUT_SECONDS=7200
