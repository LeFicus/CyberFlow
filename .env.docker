# CyberFlow Docker 环境变量
# 复制为 .env 后修改

# MySQL
MYSQL_ROOT_PASSWORD=123456
MYSQL_USER=root

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# JWT
JWT_SECRET=cyberflow-admin-jwt-secret-key-2026

# 爬虫账号 (管理平台 & 支付平台登录)
CRAWLER_USERNAME=
CRAWLER_PASSWORD=

# 端口 (修改以避让宿主机端口冲突)
# ADMIN_PORT=8080
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# MYSQL_PORT=3306
# REDIS_PORT=6379
