# CyberFlow Docker environment variables
# Copy this file to .env and replace all change-me values before deployment.

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_USER=root

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=change-me

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# Crawler platform fallbacks (admin settings take precedence)
ADMIN_API_BASE_URL=
ADMIN_API_USERNAME=
ADMIN_API_PASSWORD=
PAYMENT_API_BASE_URL=
PAYMENT_API_ACCOUNT=
PAYMENT_API_PASSWORD=
VERIFY_SSL=true

# Host ports (uncomment to override defaults)
# ADMIN_PORT=8080
# RABBITMQ_PORT=5672
# RABBITMQ_MGMT_PORT=15672
# MYSQL_PORT=3306
# REDIS_PORT=6379
