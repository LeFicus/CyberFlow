{

  "title": "//h1/text()",
  "price":"//meta[@property='og:price:amount']/@content",
  "price_regex": "[\\d.,]+",
  "description": "//div[contains(@class, 'woocommerce-Tabs-panel woocommerce-Tabs-panel--description panel entry-content wc-tab')]/text()",
  "images": "//meta[@property='og:image']/@content",
  "currency": "USD",
  "breadcrumb_links": "//nav[contains(@class, 'woocommerce-breadcrumb')]//a/text()",
  "breadcrumb_last": "//nav[contains(@class, 'woocommerce-breadcrumb')]//span/text()",
  "site_map": "//*[local-name()='sitemap']/*[local-name()='loc'][contains(text(), 'product-sitemap')]/text()"
}